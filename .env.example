# Web OAuth client ID; also used as SERVER_CLIENT_ID on Android.
GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID, registered for the Runner bundle ID.
GOOGLE_IOS_CLIENT_ID=
# OAuth client of type Web application, required on Android without Firebase.
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_ADS_BANNER_UNIT_ID=
GOOGLE_ADS_INTERSTITIAL_UNIT_ID=
